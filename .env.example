# ContextShield Environment Configuration
# Copy to .env and fill with real credentials. Do NOT commit secrets to source control.

# Moss Configuration
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=contextshield-security

# Contextual LLM Risk Evaluator Configuration (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_TARGET_LATENCY_MS=800
LLM_HARD_TIMEOUT_MS=1500

# LiveKit Voice Ingestion Configuration
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

CONTEXTSHIELD_API_URL=http://127.0.0.1:8000

LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=en
